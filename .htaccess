# Portfolio docroot (ships to domain public_html).
# Canonical publishing URL: /msrpublishing/ (WP at public_html/msrpublishing/).
<IfModule mod_rewrite.c>
	RewriteEngine On

	# Legacy bookmarks → canonical path.
	RewriteCond %{ENV:REDIRECT_STATUS} ^$
	RewriteRule ^msrsandbox/?$ /msrpublishing/ [R=301,L]
	RewriteCond %{ENV:REDIRECT_STATUS} ^$
	RewriteRule ^msrsandbox/(.*)$ /msrpublishing/$1 [R=301,L]

	# Publishing WP: route pretty URLs to index.php (fixes local RewriteBase on live + missing subfolder rules).
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^msrpublishing/?(.*)$ msrpublishing/index.php [L,QSA]
</IfModule>
